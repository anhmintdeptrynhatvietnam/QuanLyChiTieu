rules_version = '2';

// Each signed-in user (Google or anonymous) can only read and write documents
// under their own users/{uid}/ subtree. Everything else is denied by default.
// Deploy: Firebase Console > Firestore Database > Rules, or
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
